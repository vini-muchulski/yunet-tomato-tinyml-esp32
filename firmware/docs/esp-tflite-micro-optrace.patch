diff --git a/tensorflow/lite/micro/micro_interpreter_graph.cc b/tensorflow/lite/micro/micro_interpreter_graph.cc
index f0bcb60..11b6dac 100644
--- a/tensorflow/lite/micro/micro_interpreter_graph.cc
+++ b/tensorflow/lite/micro/micro_interpreter_graph.cc
@@ -44,6 +44,72 @@ const char* OpNameFromRegistration(const TFLMRegistration* registration) {
   }
 }
 
+#if defined(TFLM_OPTRACE)
+struct OpTraceStats {
+  int64_t min = 0;
+  int64_t max = 0;
+  int64_t sum = 0;
+};
+
+template <typename T>
+OpTraceStats GetOpTraceStats(const void* data, size_t bytes) {
+  const T* values = static_cast<const T*>(data);
+  const size_t count = bytes / sizeof(T);
+  OpTraceStats stats;
+  if (count == 0) {
+    return stats;
+  }
+  stats.min = values[0];
+  stats.max = values[0];
+  for (size_t i = 0; i < count; ++i) {
+    const int64_t value = values[i];
+    stats.min = std::min(stats.min, value);
+    stats.max = std::max(stats.max, value);
+    stats.sum += value;
+  }
+  return stats;
+}
+
+void TraceOutputTensor(int subgraph_idx, uint32_t operator_idx,
+                       const TFLMRegistration* registration, int tensor_idx,
+                       const TfLiteEvalTensor* tensor) {
+  size_t bytes = 0;
+  if (tensor->data.raw == nullptr ||
+      TfLiteEvalTensorByteLength(tensor, &bytes) != kTfLiteOk) {
+    return;
+  }
+  uint32_t hash = 2166136261u;
+  const uint8_t* raw = reinterpret_cast<const uint8_t*>(tensor->data.raw);
+  for (size_t i = 0; i < bytes; ++i) {
+    hash = (hash ^ raw[i]) * 16777619u;
+  }
+  OpTraceStats stats;
+  switch (tensor->type) {
+    case kTfLiteInt8:
+      stats = GetOpTraceStats<int8_t>(raw, bytes);
+      break;
+    case kTfLiteUInt8:
+      stats = GetOpTraceStats<uint8_t>(raw, bytes);
+      break;
+    case kTfLiteInt16:
+      stats = GetOpTraceStats<int16_t>(raw, bytes);
+      break;
+    case kTfLiteInt32:
+      stats = GetOpTraceStats<int32_t>(raw, bytes);
+      break;
+    default:
+      break;
+  }
+  MicroPrintf(
+      "OPTRACE op=%u name=%s tensor=%d bytes=%u hash=%08x min=%lld max=%lld "
+      "sum=%lld subgraph=%d",
+      operator_idx, OpNameFromRegistration(registration), tensor_idx,
+      static_cast<unsigned>(bytes), static_cast<unsigned>(hash),
+      static_cast<long long>(stats.min), static_cast<long long>(stats.max),
+      static_cast<long long>(stats.sum), subgraph_idx);
+}
+#endif
+
